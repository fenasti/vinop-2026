# Copy this file to .env and fill it in:  cp .env.example .env
# Never commit .env — it holds your secrets.

# ── Django ───────────────────────────────────────────────
DEBUG=True
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Production example: https://vinop.eu,https://www.vinop.eu
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000

# Empty = local SQLite file. Production: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# ── Stripe (test keys from https://dashboard.stripe.com/test/apikeys) ──
STRIPE_PUBLIC_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# Printed by `stripe listen --forward-to localhost:8000/checkout/webhook/`
STRIPE_WEBHOOK_SECRET=whsec_

# ── Shop rules ───────────────────────────────────────────
SHIPPING_FLAT_RATE=9.90
FREE_SHIPPING_THRESHOLD=120.00
# Leave empty for all 27 EU countries, or limit it, e.g. DE,AT,NL
SHIPPING_COUNTRIES=
MAX_BOTTLES_PER_WINE=36
LOW_STOCK_THRESHOLD=6

# ── Email ────────────────────────────────────────────────
# True prints emails in the terminal instead of sending them.
EMAIL_USE_CONSOLE=True
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=VinOp <hello@vinop.example>
STORE_OWNER_EMAIL=orders@vinop.example
# mandatory | optional | none
ACCOUNT_EMAIL_VERIFICATION=mandatory

# ── Uploaded photos in S3 (optional, production) ─────────
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
